[gd_scene format=4 uid="uid://c7kriyfkvc3v4"]

[ext_resource type="Texture2D" uid="uid://di5g6omwqi3yd" path="res://tetris-Sheet-outline.png" id="1_wtcfe"]

[sub_resource type="GDScript" id="GDScript_0e48y"]
script/source = "extends Node2D

var num_shapes = 0
const tile_yellow = preload(\"res://tile_yellow.tscn\")
var shapeSize: int = 0
var WINDOW_HEIGHT
var WINDOW_WIDTH
var points: int = 0

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	WINDOW_HEIGHT = (get_viewport().get_visible_rect().size.y as int)
	WINDOW_WIDTH = (get_viewport().get_visible_rect().size.x as int)
	addRandom()

# Called every frame. 'delta' is the elapsed time since the previous frame.
var time_since_last_fall = 0
var last_press_tracker = 0
func _process(delta: float) -> void:
	if num_shapes == 0:
		addRandom()
	var allFall = true
	for i in range(4):
		if !get_node(\"shape\" + str(num_shapes-(shapeSize-1) + i)).canFall(WINDOW_HEIGHT):
			allFall = false
			break
	
	for i in range(shapeSize):
		for j in range(1, num_shapes-(shapeSize-1)):
			if (get_node(\"shape\" + str(num_shapes-(shapeSize-1) + i)).position.x == get_node(\"shape\" + str(j)).position.x):
				if (!get_node(\"shape\" + str(num_shapes-(shapeSize-1) + i)).position.y+16 < get_node(\"shape\" + str(j)).position.y):
					allFall = false
					break
	
	if allFall:
		time_since_last_fall += delta
		if time_since_last_fall >= 1:
			for i in range(shapeSize):
				get_node(\"shape\" + str(num_shapes - (shapeSize-1) + i)).position.y += 16
				time_since_last_fall = 0
	else:
		addRandom()
		
	#checks each row
	for i in range(38):
		#checks all the blocks to see if there are 20 in each row
		var blockInRow = 0
		for j in range(1, num_shapes):
			if get_node(\"shape\" + str(j)).position.y == 24 + (i*16):
				blockInRow+=1
		if blockInRow == 20:
			for j in range(1, num_shapes):
				if get_node(\"shape\" + str(j)).position.y == 24 + (i*16):
					remove_child(get_node(\"shape\" + str(j)))
				else:
					if (get_node(\"shape\" + str(j)).position.y< 616):
						get_node(\"shape\" + str(j)).position.y += 16
			
			#renames the blocks
			var num = 1
			for j in get_children():
				for k in range(1, num_shapes+1):
					if j.name == (\"shape\" + str(k)):
						j.name = \"shape\" + str(num)
						num+=1
			num = 0
			num_shapes -= 20
			points += 20
			
	# called when left arrow is pressed
	if Input.is_action_pressed(\"leftArrow\"):
		if last_press_tracker >= 0.2:
			var allLeft = true
			for i in range(4):
				if !get_node(\"shape\" + str(num_shapes-(shapeSize-1)+i)).position.x - 24 > 0:
					allLeft = false
					break
			
			for i in range(shapeSize):
				for j in range(1, num_shapes-(shapeSize-1)):
					if (!get_node(\"shape\" + str(num_shapes-(shapeSize-1) + i)).position.x-16 < get_node(\"shape\" + str(j)).position.x && get_node(\"shape\" + str(j)).position.y == get_node(\"shape\" + str(num_shapes - (shapeSize-1) + i)).position.y):
						allLeft = false
						break
			
			if allLeft:
				for i in range(4):
					get_node(\"shape\" + str(num_shapes-(shapeSize-1)+i)).position.x -= 16
			
			last_press_tracker = 0
	
	# called when right arrow is pressed
	if Input.is_action_pressed(\"rightArrow\"):
		if last_press_tracker >= 0.2:
			var allRight = true
			for i in range(4):
				if !get_node(\"shape\" + str(num_shapes-(shapeSize-1)+i)).position.x + 24 < WINDOW_WIDTH:
					allRight = false
					break
			
			for i in range(shapeSize):
				for j in range(1, num_shapes-(shapeSize-1)):
					if (!get_node(\"shape\" + str(num_shapes-(shapeSize-1) + i)).position.x+16 < get_node(\"shape\" + str(j)).position.x && get_node(\"shape\" + str(j)).position.y == get_node(\"shape\" + str(num_shapes - (shapeSize-1) + i)).position.y):
						allRight = false
						break
				
			if allRight:
				for i in range(4):
					get_node(\"shape\" + str(num_shapes-(shapeSize-1)+i)).position.x += 16
			
			last_press_tracker = 0
	
	#called when down arrow is pressed
	if Input.is_action_pressed(\"downArrow\"):
		if last_press_tracker >= 0.2:
			allFall = true
			for i in range(4):
				if !get_node(\"shape\" + str(num_shapes-(shapeSize-1)+i)).position.y + 24 < WINDOW_HEIGHT:
					allFall = false
					break
			if allFall:
				for i in range(4):
					get_node(\"shape\" + str(num_shapes-(shapeSize-1)+i)).position.y += 16
			
			last_press_tracker = 0
	
	if Input.is_action_pressed(\"spacebar\"):
		while true:
			allFall = true
			for i in range(4):
				if !get_node(\"shape\" + str(num_shapes-(shapeSize-1)+i)).position.y + 24 < WINDOW_HEIGHT:
					allFall = false
					break
				else:
					for j in range(1, num_shapes + 1):
						if not j == num_shapes-(shapeSize-1)+i:
							if get_node(\"shape\" + str(j)).position.x == get_node(\"shape\" + str(num_shapes-(shapeSize-1)+i)).position.x:
								if not get_node(\"shape\" + str(num_shapes-(shapeSize-1)+i)).position.y + 16 < get_node(\"shape\" + str(j)).position.y:
									# should make it drop to the lowest, not prevent dropping
									allFall = false
									break
								
			if allFall:
				for i in range(4):
					get_node(\"shape\" + str(num_shapes-(shapeSize-1)+i)).position.y += 16
			else:
				break
	
	last_press_tracker += delta


func _input(event: InputEvent) -> void:
	if Input.is_action_pressed(\"upArrow\"):
		# used AI to help debug bound errors
		for i in range(num_shapes - (shapeSize) + 1, num_shapes - (shapeSize) + 5):
			if not i == num_shapes - (shapeSize) + 2:
				print(\"made it\")
				var difference_x = (get_node(\"shape\" + str(i)).position.x - get_node(\"shape\" + str(num_shapes - (shapeSize) + 2)).position.x)
				var difference_y = (get_node(\"shape\" + str(i)).position.y - get_node(\"shape\" + str(num_shapes - (shapeSize) + 2)).position.y)
				get_node(\"shape\" + str(i)).position.x -= difference_x
				get_node(\"shape\" + str(i)).position.y -= difference_y
				get_node(\"shape\" + str(i)).position.x -= difference_y
				get_node(\"shape\" + str(i)).position.y -= difference_x
	

func addRandom() -> void:
	var i = randi_range(0, 5)
	if i == 0:
		addSquare();
	else: if i == 1:
		addLHospital()
	else: if i == 2:
		addLongOne()
	else: if i == 3:
		addL()
	else: if i == 4:
		addT()

#add shape
func addShape() -> void:
	var shape = tile_yellow.instantiate()
	shape.position = Vector2(24+160, 24)
	num_shapes += 1
	shape.name = \"shape\" + str(num_shapes)
	$\".\".add_child(shape)

func addSquare() -> void:
	shapeSize = 0
	for i in range(2):
		for j in range(2):
			var block = tile_yellow.instantiate()
			block.position = Vector2(184 + (i*16), 24+(j * 16))
			num_shapes+=1
			block.name = \"shape\" + str(num_shapes)
			$\".\".add_child(block)
			shapeSize +=1
	

func addLHospital() -> void:
	shapeSize = 0
	
	for i in range(2):
		for j in range(2):
			var block = tile_yellow.instantiate()
			block.position = Vector2(184 + (i*16), 24+(j * 16) + (i*16))
			num_shapes+=1
			block.name = \"shape\" + str(num_shapes)
			$\".\".add_child(block)
			shapeSize +=1

func addLongOne() -> void:
	shapeSize = 0
	for i in range(4):
		var block = tile_yellow.instantiate()
		block.position = Vector2(184 + (i*16) -16 , 24)
		num_shapes+=1
		block.name = \"shape\" + str(num_shapes)
		$\".\".add_child(block)
		shapeSize +=1

func addL() -> void:
	shapeSize = 4
	for i in range(4):
		var block = tile_yellow.instantiate()
		if i == 3:
			block.position = Vector2(184 + ((i-2) * 16), 24 + ((i-1) * 16))
		else:
			block.position = Vector2(184 , 24 + (i*16))
		num_shapes+=1
		block.name = \"shape\" + str(num_shapes)
		add_child(block)

func addT() -> void:
	shapeSize = 4
	for i in range(4):
		var block = tile_yellow.instantiate()
		if i == 3:
			block.position = Vector2(184, 24+ ((i-2)*16))
		else:
			block.position = Vector2(184 - 16 + (i *16), 24)
		num_shapes += 1
		block.name = \"shape\" + str(num_shapes)
		add_child(block)
"

