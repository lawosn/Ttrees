[gd_scene format=4 uid="uid://c7kriyfkvc3v4"]

[ext_resource type="Texture2D" uid="uid://di5g6omwqi3yd" path="res://tetris-Sheet-outline.png" id="1_wtcfe"]

[sub_resource type="GDScript" id="GDScript_0e48y"]
script/source = "extends Node2D

var num_squares = 0
const blocks: Array[String] = [
	\"res://square.tscn\", 
	\"res://long_one.tscn\",
	\"res://l'hospital_left.tscn\",
	\"res://l'hospital_right.tscn\",
	\"res://l,left.tscn\",
	\"res://l,right.tscn\",
	\"res://t_block.tscn\"]

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	addShape()

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	if !fall(delta):
		addShape()


func _input(event: InputEvent) -> void:
	# called when left arrow is pressed
	if event.is_action_pressed(\"leftArrow\"):
		if !event.is_action_released(\"leftArrow\"):
			if get_node(\"shape\" + str(num_squares)).position.x - 16 > 0:
				get_node(\"shape\" + str(num_squares)).position.x -= 16
	
	# called when right arrow is pressed
	if event.is_action_pressed(\"rightArrow\"):
		if !event.is_action_released(\"rightArrow\"):
			if get_node(\"shape\" + str(num_squares)).position.x + 48 < (get_viewport().get_visible_rect().size.x as int):
				get_node(\"shape\" + str(num_squares)).position.x += 16
	
	#called when down arrow is pressed
	if event.is_action_pressed(\"downArrow\"):
		if !event.is_action_released(\"downArrow\"):
			if get_node(\"shape\" + str(num_squares)).position.y + 64 < (get_viewport().get_visible_rect().size.y as int):
				get_node(\"shape\" + str(num_squares)).position.y += 16
	
	#makes the block move up
	#i know
	#im very silly arent I 
	if event.is_action_pressed(\"upArrow\"):
		get_node(\"shape\" + str(num_squares)).position.y -= 16

#returns true if it can drop/ has space under it
#returns false when it cant
var time_since_last_drop = 0
func fall(delta: float) -> bool:
	# Source: multiple AI queries/my own
	time_since_last_drop += delta
	if get_node(\"shape\" + str(num_squares)).position.y + 48 < ((get_viewport().get_visible_rect().size.y as int) / 16) * 16:
		if time_since_last_drop >= 1:
			get_node(\"shape\" + str(num_squares)).position.y += 16
			time_since_last_drop = 0
		return true
	return false

#add shape
func addShape() -> void:
	var rand = randi_range(0, 7)
	var shape_resource = preload(blocks[0])
	var shape = shape_resource.instantiate()
	shape.position = Vector2(16, 16)
	num_squares += 1
	shape.name = \"shape\" + str(num_squares)
	add_child(shape)

func bottomCheck() -> void:
	pass
"

