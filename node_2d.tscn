[ext_resource type="Texture2D" uid="uid://di5g6omwqi3yd" path="res://tetris-Sheet-outline.png" id="1_wtcfe"]

[sub_resource type="GDScript" id="GDScript_0e48y"]
script/source = "extends Node2D

var num_shapes = 0
const tile_yellow = preload(\"res://tile_yellow.tscn\")
var shapeSize: int = 0
var WINDOW_HEIGHT
var WINDOW_WIDTH

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	WINDOW_HEIGHT = (get_viewport().get_visible_rect().size.y as int)
	WINDOW_WIDTH = (get_viewport().get_visible_rect().size.x as int)
	addLongOne()

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	if num_shapes == 0:
		addRandom()
	var allFall = true
	for i in range(4):
		if !get_node(\"shape\" + str(num_shapes-(shapeSize-1) + i)).canFall(WINDOW_HEIGHT):
			allFall = false
			break
	
	for i in range(shapeSize):
		for j in range(1, num_shapes-(shapeSize-1)):
			if (!get_node(\"shape\" + str(num_shapes-(shapeSize-1) + i)).position.y+16 < get_node(\"shape\" + str(j)).position.y) && (get_node(\"shape\" + str(num_shapes-(shapeSize-1) + i)).position.x == get_node(\"shape\" + str(j)).position.x):
				allFall = false
				break
	
	if allFall:
		for i in range(shapeSize):
			get_node(\"shape\" + str(num_shapes - (shapeSize-1) + i)).fall(delta, WINDOW_HEIGHT)
	else:
		addLongOne()
	
	#checks each row
	for i in range(38):
		#checks all the blocks to see if there are 20 in each row
		var blockInRow = 0
		for j in range(1, num_shapes):
			if get_node(\"shape\" + str(j)).position.y == 24 + (i*16):
				blockInRow+=1
		if blockInRow == 20:
			for j in range(1, num_shapes):
				if get_node(\"shape\" + str(j)).position.y == 24 + (i*16):
					remove_child(get_node(\"shape\" + str(j)))
					num_shapes -= 1
				else:
					get_node(\"shape\" + str(j)).position.y += 16


func _input(event: InputEvent) -> void:
	# called when left arrow is pressed
	if event.is_action_pressed(\"leftArrow\"):
		var allLeft = true
		for i in range(4):
			if !get_node(\"shape\" + str(num_shapes-(shapeSize-1)+i)).position.x - 24 > 0:
				allLeft = false
				break
		
		for i in range(shapeSize):
			for j in range(1, num_shapes-(shapeSize-1)):
				if (!get_node(\"shape\" + str(num_shapes-(shapeSize-1) + i)).position.x-16 < get_node(\"shape\" + str(j)).position.x && get_node(\"shape\" + str(j)).position.y == get_node(\"shape\" + str(num_shapes - (shapeSize-1) + i)).position.y):
					allLeft = false
					break
		
		if allLeft:
			for i in range(4):
				get_node(\"shape\" + str(num_shapes-(shapeSize-1)+i)).position.x -= 16
	
	# called when right arrow is pressed
	if event.is_action_pressed(\"rightArrow\"):
		var allRight = true
		for i in range(4):
			if !get_node(\"shape\" + str(num_shapes-(shapeSize-1)+i)).position.x + 24 < WINDOW_WIDTH:
				allRight = false
				break
		
		for i in range(shapeSize):
			for j in range(1, num_shapes-(shapeSize-1)):
				if (!get_node(\"shape\" + str(num_shapes-(shapeSize-1) + i)).position.x+16 < get_node(\"shape\" + str(j)).position.x && get_node(\"shape\" + str(j)).position.y == get_node(\"shape\" + str(num_shapes - (shapeSize-1) + i)).position.y):
					allRight = false
					break
			
		if allRight:
			for i in range(4):
				get_node(\"shape\" + str(num_shapes-(shapeSize-1)+i)).position.x += 16
	
	#called when down arrow is pressed
	if event.is_action_pressed(\"downArrow\"):
		var allFall = true
		for i in range(4):
			if !get_node(\"shape\" + str(num_shapes-(shapeSize-1)+i)).position.y + 24 < WINDOW_HEIGHT:
				allFall = false
				break
		if allFall:
			for i in range(4):
				get_node(\"shape\" + str(num_shapes-(shapeSize-1)+i)).position.y += 16
	
	#makes the block move up
	#i know
	#im very silly arent I 
	if event.is_action_pressed(\"upArrow\"):
		for i in range(4):
			get_node(\"shape\" + str(num_shapes-(shapeSize-1)+i)).position.y -= 16

func addRandom() -> void:
	var i = randi_range(0, 3)
	if i == 0:
		addSquare();
	else: if i == 1:
		addLHospital()
	else: if i == 2:
		addLongOne()

#add shape
func addShape() -> void:
	var shape = tile_yellow.instantiate()
	shape.position = Vector2(24+160, 24)
	num_shapes += 1
	shape.name = \"shape\" + str(num_shapes)
	add_child(shape)

func addSquare() -> void:
	shapeSize = 0
	for i in range(2):
		for j in range(2):
			var block = tile_yellow.instantiate()
			block.position = Vector2(184 + (i*16), 24+(j * 16))
			num_shapes+=1
			block.name = \"shape\" + str(num_shapes)
			add_child(block)
			shapeSize +=1
	

func addLHospital() -> void:
	shapeSize = 0
	
	for i in range(2):
		for j in range(2):
			var block = tile_yellow.instantiate()
			block.position = Vector2(184 + (i*16), 24+(j * 16) + (i*16))
			num_shapes+=1
			block.name = \"shape\" + str(num_shapes)
			add_child(block)
			shapeSize +=1

func addLongOne() -> void:
	shapeSize = 0
	for i in range(4):
		var block = tile_yellow.instantiate()
		block.position = Vector2(184 + (i*16) -16 , 24)
		num_shapes+=1
		block.name = \"shape\" + str(num_shapes)
		add_child(block)
		shapeSize +=1
"

